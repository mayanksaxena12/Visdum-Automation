<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Login Module Suite" verbose="1">

    <listeners>
        <listener class-name="listeners.ExtentReportListener"/>
    </listeners>

    <test name="Login Module Tests">
        <classes>
            <class name="tests.login.LoginValidationTest"/>
            <class name="tests.login.InvalidCredentialsTest"/>
            <class name="tests.login.ValidLoginTest"/>
        </classes>
    </test>

</suite>
